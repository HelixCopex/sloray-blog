---
import Icon from '../components/ui/Icon.astro';
import BaseLayout from './BaseLayout.astro';
import { serverGet, type Session } from '../lib/api';
interface Props { title: string }
const { title } = Astro.props;
const cookie = Astro.request.headers.get('cookie') ?? '';
let session: Session | undefined;
try { session = await serverGet<Session>('/auth/session', { headers: { cookie } }); } catch { /* 页面显示具体错误。 */ }
const admin = session?.user?.role === 'admin';
const current = Astro.url.pathname;
const links = [
  { href: '/admin/posts', label: '文章', icon: 'edit' },
  ...(admin ? [{ href: '/admin/pages', label: '页面', icon: 'article' }, { href: '/admin/media', label: '媒体', icon: 'image' }] : []),
  { href: '/admin/comments', label: '评论', icon: 'comment' },
  ...(admin ? [{ href: '/admin/themes', label: '主题', icon: 'palette' }, { href: '/admin/users', label: '账号', icon: 'person' }, { href: '/admin/settings', label: '设置', icon: 'settings' }] : []),
];
---
<BaseLayout title={title}>
  <div class="admin-shell">
    <div class="admin-bar">
      <nav aria-label="后台导航">{links.map(link => <a href={link.href} aria-current={current.startsWith(link.href) ? 'page' : undefined} data-astro-prefetch="false" data-astro-reload={link.href === '/admin/settings' || undefined}><Icon name={link.icon} />{link.label}</a>)}</nav>
      {session?.user && <div class="admin-account"><span>{session.user.display_name}</span><button type="button" data-logout><Icon name="logout" />退出登录</button></div>}
    </div>
    <slot />
  </div>
</BaseLayout>
<script>
  import { clientGet, type Session } from '../lib/api';
  document.addEventListener('astro:page-load', () => {
    const button = document.querySelector<HTMLButtonElement>('[data-logout]');
    if (!button || button.dataset.bound) return;
    button.dataset.bound = 'true';
    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        const session = await clientGet<Session>('/auth/session');
        const form = document.createElement('form');
        form.method = 'POST'; form.action = '/logout';
        const input = document.createElement('input');
        input.type = 'hidden'; input.name = 'csrf_token'; input.value = session.csrf_token;
        form.append(input); document.body.append(form); form.submit();
      } catch { button.disabled = false; button.textContent = '退出失败，点击重试'; }
    });
  });
</script>
