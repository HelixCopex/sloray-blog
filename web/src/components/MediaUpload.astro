---
import Icon from './ui/Icon.astro';
---
<section id="media-upload" class="media-upload" aria-labelledby="media-upload-title">
  <div class="media-upload-heading"><h3 id="media-upload-title">上传图片</h3><p class="hint" id="media-file-help">可一次选择多张 PNG、JPEG、WebP，每张最大 10 MiB。</p></div>
  <label for="image-file">选择图片</label>
  <input id="image-file" class="media-file-input" type="file" accept="image/png,image/jpeg,image/webp" multiple aria-describedby="media-file-help media-file-selection" />
  <div class="media-upload-actions">
    <p class="hint" id="media-file-selection" data-file-selection>尚未选择图片</p>
    <button type="button" class="filled" data-upload disabled><Icon name="upload" /><span data-upload-label>上传图片</span></button>
  </div>
  <p class="hint" data-upload-status role="status" hidden></p>
  <progress data-progress max="100" value="0" aria-label="所选图片上传进度" hidden />
  <ul class="media-upload-list" data-upload-list aria-label="所选图片上传状态" hidden></ul>
  <details data-media-error hidden><summary>上传错误详情</summary><pre data-media-error-details></pre></details>
</section>
