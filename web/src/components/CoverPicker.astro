---
import Icon from './ui/Icon.astro';
import { serverGet } from '../lib/api';
import type { components } from '../lib/schema';
interface Props { id?: string | null; canChoose: boolean }
const { id, canChoose } = Astro.props;
let cover: components['schemas']['Media'] | undefined;
if (id) { try { cover = await serverGet(`/media/${id}`); } catch { /* 未就绪封面显示状态。 */ } }
---
<fieldset class="cover-picker">
  <legend>文章封面</legend><input id="cover-media" name="cover_media_id" type="hidden" value={id ?? ''} />
  <img data-cover-preview class="cover" src={cover?.variants.at(-1)?.url} alt="当前文章封面" width="240" hidden={!cover?.variants.length} />
  <p data-cover-status>{id ? '已选择封面。' : '尚未选择封面。'}</p>
  {canChoose && <button type="button" data-open-media><Icon name="image" />从媒体库选择封面</button>}
  <button type="button" data-clear-cover hidden={!id}><Icon name="close" />移除封面</button>
</fieldset>
<script>
  document.addEventListener('astro:page-load', () => {
    const button = document.querySelector<HTMLButtonElement>('[data-clear-cover]');
    if (!button || button.dataset.bound) return;
    button.dataset.bound = 'true';
    button.addEventListener('click', () => {
      const input = document.querySelector<HTMLInputElement>('#cover-media')!;
      input.value = ''; input.dispatchEvent(new Event('input', { bubbles: true }));
      document.querySelector<HTMLImageElement>('[data-cover-preview]')!.hidden = true;
      document.querySelector<HTMLElement>('[data-cover-status]')!.textContent = '封面已移除，保存文章后生效。';
      button.hidden = true;
    });
  });
</script>
