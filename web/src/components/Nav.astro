---
import Icon from './ui/Icon.astro';
import { serverGet, type Session, type PageSummary } from '../lib/api';
import { allPublicPages } from '../lib/pages';
let pages: PageSummary[] = [];
let signedIn = false;
if (!Astro.isPrerendered) {
  try { pages = (await allPublicPages()).filter(page => page.show_in_nav); } catch { /* 站点未配置时保留基础导航。 */ }
  const cookie = Astro.request.headers.get('cookie');
  if (cookie) {
    try { signedIn = Boolean((await serverGet<Session>('/auth/session', { headers: { cookie } })).user); } catch { /* 会话不可用时隐藏管理入口。 */ }
  }
}
const links = [
  { href: '/', label: '首页', icon: 'home' },
  { href: '/search', label: '搜索', icon: 'search' },
  ...pages.map(page => ({ href: `/${encodeURIComponent(page.slug)}`, label: page.title, icon: 'article' })),
  ...(signedIn ? [{ href: '/admin/posts', label: '管理后台', icon: 'edit' }] : []),
];

const current = Astro.url.pathname;
---

<nav aria-label="站点导航">
  {
    links.map(({ href, label, icon }) => (
      <a href={href} data-astro-prefetch={href.startsWith('/admin/') ? 'false' : undefined} aria-current={current === href ? 'page' : undefined}>
        <Icon name={icon} />{label}
      </a>
    ))
  }
</nav>
