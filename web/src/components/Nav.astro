---
import Icon from './ui/Icon.astro';
import { serverGet, type Session, type PageSummary } from '../lib/api';
import { allPublicPages } from '../lib/pages';
import Appearance from './islands/Appearance.astro';
let pages: PageSummary[] = [];
let signedIn = false;
if (!Astro.isPrerendered) {
  try { pages = (await allPublicPages()).filter(page => page.show_in_nav); } catch { /* 站点未配置时保留基础导航。 */ }
  const cookie = Astro.request.headers.get('cookie');
  if (cookie) {
    try { signedIn = Boolean((await serverGet<Session>('/auth/session', { headers: { cookie } })).user); } catch { /* 会话不可用时隐藏管理入口。 */ }
  }
}
const links = [
  { href: '/search', label: '搜索', icon: 'search' },
  ...pages.map(page => ({ href: `/${encodeURIComponent(page.slug)}`, label: page.title, icon: 'article' })),
  ...(signedIn ? [{ href: '/admin/posts', label: '管理后台', icon: 'edit' }] : []),
];

const current = Astro.url.pathname;
---

<site-dock class="site-dock" data-expanded="false">
<div class="dock-panel">
<nav id="site-navigation" aria-label="站点导航">
  {
    links.map(({ href, label, icon }) => (
      <a href={href} aria-label={label} title={label} data-astro-prefetch={href.startsWith('/admin/') ? 'false' : undefined} aria-current={(current === href || href === '/admin/posts' && current.startsWith('/admin/')) ? 'page' : undefined}>
        <span class="dock-symbol"><Icon name={icon} /></span>
      </a>
    ))
  }
</nav>
<div class="dock-tools">
  <Appearance />
  <button type="button" class="dock-tool text" aria-label="返回顶部" title="返回顶部" data-back-top><Icon name="up" /></button>
  <button type="button" class="dock-tool text dock-toggle" aria-label="展开导航" title="展开导航" aria-expanded="false" aria-controls="site-navigation" data-dock-toggle><Icon name="expand" /></button>
</div>
</div>
</site-dock>
<script>import '../lib/dock';</script>
