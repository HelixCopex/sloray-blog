---
import Icon from './ui/Icon.astro';
import LoadingImage from './ui/LoadingImage.astro';
import { serverGet, type Session, type PageSummary } from '../lib/api';
import { allPublicPages } from '../lib/pages';
import Appearance from './islands/Appearance.astro';
import type { DockContext } from '../lib/dock-context';
interface Props { context: DockContext }
const { context } = Astro.props;
let pages: PageSummary[] = [], user: Session['user'];
if (!Astro.isPrerendered) {
  try { pages = (await allPublicPages()).filter(page => page.show_in_nav); } catch {}
  const cookie = Astro.request.headers.get('cookie');
  if (cookie) { try { user = (await serverGet<Session>('/auth/session', { headers: { cookie } })).user; } catch {} }
}
const current = Astro.url.pathname;
const editor = current.match(/^\/admin\/(posts|pages)\/([^/]+)$/);
const canEdit = user && (user.role === 'admin' || context.kind === 'post' && user.id === context.author_id);
const editHref = canEdit && context.id && (context.kind === 'post' ? `/admin/posts/${context.id}` : context.kind === 'page' ? `/admin/pages/${context.id}` : '');
const favicon = Astro.locals.siteIdentity?.favicon_url ?? '/favicon.svg';
const siteName = Astro.locals.siteIdentity?.site_name ?? '静线数据库';
const links = [
  ...pages.map(page => ({ href: `/${encodeURIComponent(page.slug)}`, label: page.title, icon: page.dock_icon ?? 'article' })),
  ...(user ? [{ href: '/admin/posts', label: '管理后台', icon: 'server' }] : []),
];
---
<site-dock class="site-dock" data-expanded="false" data-context={JSON.stringify(context)} transition:persist="site-dock" transition:animate="none">
<div class="dock-panel">
<nav id="site-navigation" aria-label="站点导航">
  <a href="/" data-dock-key="home" aria-label="主页" title={`${siteName} · 主页`} aria-current={current === '/' ? 'page' : undefined}><span class="dock-symbol"><LoadingImage frameClass="dock-favicon-frame" class="dock-favicon" src={favicon} alt="" width={28} height={28} referrerpolicy="no-referrer" /><Icon name="home" class="favicon-fallback" /></span></a>
  <a href="/search" data-dock-key="search" data-search-open aria-label="搜索" title="搜索" aria-haspopup="dialog" aria-current={current === '/search' ? 'page' : undefined}><span class="dock-symbol"><Icon name="search" /></span></a>
  {links.map(({ href, label, icon }) => <a href={href} data-dock-key={href} aria-label={label} title={label} data-astro-prefetch={href.startsWith('/admin/') ? 'false' : undefined} aria-current={(current === href || href === '/admin/posts' && current.startsWith('/admin/')) ? 'page' : undefined}><span class="dock-symbol"><Icon name={icon} /></span></a>)}
</nav>
<div class="dock-context" role="group" aria-label="当前页面操作">
  {context.kind === 'post' && <><button type="button" class="dock-tool text" data-dock-key="like" data-like disabled aria-label="点赞" title="点赞" aria-pressed="false"><Icon name="favorite" /></button><button type="button" class="dock-tool text" data-dock-key="comment" data-comment-open aria-label="评论" title="评论" aria-haspopup="dialog"><Icon name="comment" /></button></>}
  {editHref && <a class="dock-tool" href={editHref} data-dock-key="edit-resource" aria-label={context.kind === 'post' ? '编辑文章' : '编辑页面'} title={context.kind === 'post' ? '编辑文章' : '编辑页面'} data-astro-prefetch="false"><Icon name="edit" /></a>}
  {editor && user && <><button type="button" class="dock-tool text" data-dock-key="editor-save" data-editor-action="save" aria-label="保存草稿" title="保存草稿"><Icon name="save" /></button><button type="button" class="dock-tool text" data-dock-key="editor-publish" data-editor-action="publish" aria-label={editor[1] === 'posts' ? '发布文章' : '发布页面'} title={editor[1] === 'posts' ? '发布文章' : '发布页面'}><Icon name="check" /></button>{user.role === 'admin' && <button type="button" class="dock-tool text" data-dock-key="editor-media" data-editor-action="media" aria-label="打开媒体选择器" title="打开媒体选择器"><Icon name="image" /></button>}<a class="dock-tool" data-dock-key="editor-preview" data-editor-preview href="#" target="_blank" rel="noopener" aria-label="查看已发布内容" title="查看已发布内容" hidden><Icon name="preview" /></a>{editor[2] !== 'new' && <button type="button" class="dock-tool text" data-dock-key="editor-delete" data-editor-action="delete" aria-label={editor[1] === 'posts' ? '删除文章' : '删除页面'} title={editor[1] === 'posts' ? '删除文章' : '删除页面'}><Icon name="delete" /></button>}</>}
</div>
<div class="dock-tools"><Appearance /><button type="button" class="dock-tool text" data-dock-key="up" aria-label="返回顶部" title="返回顶部" data-back-top><Icon name="up" /></button><button type="button" class="dock-tool text dock-toggle" data-dock-key="expand" aria-label="展开导航" title="展开导航" aria-expanded="false" aria-controls="site-navigation" data-dock-toggle><Icon name="expand" /></button></div>
</div>
</site-dock>
<script>import '../lib/dock';</script>
