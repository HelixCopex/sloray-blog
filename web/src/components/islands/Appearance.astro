---
import Icon from '../ui/Icon.astro';
---
<appearance-control class="appearance"><button type="button" class="dock-tool text" aria-label="外观：跟随系统，点击切换" data-appearance-toggle><Icon name="system" /><span>外观</span></button></appearance-control>
<script>
  const choices = ['system', 'light', 'dark'] as const;
  type Appearance = typeof choices[number];
  function stored(): Appearance {
    try { const value = localStorage.getItem('sloray-appearance'); return choices.includes(value as Appearance) ? value as Appearance : 'system'; } catch { return 'system'; }
  }
  let current = stored();
  function apply() {
    const value = current;
    if (value === 'system') delete document.documentElement.dataset.appearance;
    else document.documentElement.dataset.appearance = value;
    document.querySelectorAll('[data-appearance-toggle]').forEach(button => {
      button.setAttribute('aria-label', `外观：${{ system: '跟随系统', light: '浅色', dark: '深色' }[value]}，点击切换`);
      button.querySelector('use')?.setAttribute('href', `#mi-${value === 'light' ? 'light' : value === 'dark' ? 'dark' : 'system'}`);
      const icon = button.querySelector<SVGElement>('.icon'); if (icon) icon.dataset.icon = value === 'light' ? 'light' : value === 'dark' ? 'dark' : 'system';
    });
  }
  class AppearanceControl extends HTMLElement {
    connectedCallback() {
      if (this.dataset.bound) return;
      this.dataset.bound = 'true'; apply();
      this.querySelector('button')?.addEventListener('click', () => {
        const value = choices[(choices.indexOf(current) + 1) % choices.length];
        try { localStorage.setItem('sloray-appearance', value); } catch { /* 存储禁用时仍可切换本页。 */ }
        current = value; apply();
      });
    }
  }
  if (!customElements.get('appearance-control')) customElements.define('appearance-control', AppearanceControl);
  document.addEventListener('astro:after-swap', apply);
  window.addEventListener('storage', () => { current = stored(); apply(); });
</script>
