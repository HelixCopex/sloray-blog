---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { serverGet, type Session } from '../../lib/api';
import type { components } from '../../lib/schema';
type User = components['schemas']['User'];
Astro.response.headers.set('Cache-Control', 'no-store');
const cookie = Astro.request.headers.get('cookie') ?? '';
let users: User[] = [];
let failed = false;
try {
  const session = await serverGet<Session>('/auth/session', { headers: { cookie } });
  if (!session.user) return Astro.redirect('/login');
  if (session.user.role !== 'admin') return new Response('权限不足', { status: 403 });
  users = await serverGet<User[]>('/admin/users', { headers: { cookie } });
} catch { failed = true; Astro.response.status = 503; }
---
<BaseLayout title="作者管理">
  <h1>作者管理</h1><p>最多展示 1000 个账号。</p><p><a href="/admin/posts" data-astro-prefetch="false">返回写作</a></p>
  {failed ? <p role="alert">服务暂时不可用。</p> : <ul>{users.map(user => <li>{user.display_name} · {user.email} · {user.role}</li>)}</ul>}
  <form id="create-user">
    <label for="user-name">昵称</label><input id="user-name" name="display_name" required maxlength="80" />
    <label for="user-email">邮箱</label><input id="user-email" name="email" type="email" required maxlength="254" />
    <label for="user-password">初始密码</label><input id="user-password" name="password" type="password" required minlength="8" maxlength="1024" autocomplete="new-password" />
    <label for="user-role">角色</label><select id="user-role" name="role"><option value="author">作者</option><option value="admin">管理员</option></select>
    <button>创建账号</button><p id="user-notice" role="status"></p>
  </form>
</BaseLayout>
<script>
  import { clientWrite } from '../../lib/api';
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('#create-user');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';
    form.addEventListener('submit', async event => {
      event.preventDefault(); const button = form.querySelector('button')!; button.disabled = true;
      try { await clientWrite('/admin/users', 'POST', Object.fromEntries(new FormData(form))); window.location.reload(); }
      catch (error) { document.querySelector('#user-notice')!.textContent = String(error); button.disabled = false; }
    });
  });
</script>
