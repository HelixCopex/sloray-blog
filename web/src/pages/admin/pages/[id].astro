---
import DockIconPicker from '../../../components/DockIconPicker.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Icon from '../../../components/ui/Icon.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import MarkdownEditor from '../../../components/MarkdownEditor.astro';
import MediaPicker from '../../../components/MediaPicker.astro';
import { serverGet, ApiRequestError, type Session, type Page } from '../../../lib/api';
const id = Astro.params.id ?? 'new';
const cookie = Astro.request.headers.get('cookie') ?? '';
let page: Page | undefined;
let failed = false;
try {
  const session = await serverGet<Session>('/auth/session', { headers: { cookie } });
  if (!session.user) return Astro.redirect('/login');
  if (session.user.role !== 'admin') { failed = true; Astro.response.status = 403; }
  else if (id !== 'new') page = await serverGet<Page>(`/admin/pages/${encodeURIComponent(id)}`, { headers: { cookie } });
} catch (error) { failed = true; Astro.response.status = error instanceof ApiRequestError ? error.status : 503; }
---
<AdminLayout title={page ? `编辑：${page.title}` : '新建页面'}>
  <p><a href="/admin/pages" data-astro-prefetch="false">返回页面列表</a></p>
  <PageHeader title={page ? '编辑页面' : '新建页面'} />
  {failed ? <p role="alert">{Astro.response.status === 403 ? '只有管理员可以编辑页面。' : '页面不可访问或服务暂时不可用。'}</p> : <>
    <form id="editor" data-kind="pages" data-id={id} data-version={page?.version ?? ''}>
      <label for="title">标题</label><input id="title" name="title" required maxlength="200" value={page?.title} />
      <label for="slug">页面地址</label><input id="slug" name="slug" required maxlength="160" value={page?.slug} />
      <p class="hint">例如 about 对应 /about；使用文字、数字、短横线或下划线，不能使用 login、admin 等系统路径。</p>
      <label for="summary">页面摘要</label><textarea id="summary" name="summary" maxlength="1000">{page?.summary}</textarea>
      <button type="button" data-open-media class="editor-action-fallback"><Icon name="image" />打开媒体选择器</button>
      <MarkdownEditor value={page?.body_md} />
      <label for="status">保存后状态</label><select id="status" name="status"><option value="draft" selected={!page || page.status === 'draft'}>草稿（仅后台可见）</option><option value="published" selected={page?.status === 'published'}>发布（立即公开）</option></select>
      <label class="checkbox-label" for="show-in-nav"><input type="checkbox" id="show-in-nav" name="show_in_nav" checked={page?.show_in_nav ?? true} />显示在站点导航中</label>
      <label for="nav-order">导航排序</label><input id="nav-order" name="nav_order" type="number" min="-2147483648" max="2147483647" required value={page?.nav_order ?? 0} /><p class="hint">数字越小越靠前；草稿始终不会出现在公开导航中。</p>
      <DockIconPicker value={page?.dock_icon} />
      <button type="submit" class="editor-action-fallback"><Icon name="save" />保存</button>
      <a class="editor-action-fallback" data-public-link href={page ? `/${encodeURIComponent(page.slug)}` : '#'} hidden={page?.status !== 'published'} target="_blank" rel="noopener">查看已发布页面</a>
      {page && <button type="button" data-delete-content class="danger editor-action-fallback"><Icon name="delete" />删除页面</button>}
      <p id="editor-notice" role="status" aria-live="polite"></p>
    </form>
    <MediaPicker />
  </>}
</AdminLayout>
<script>
  import { bindEditor } from '../../../lib/editor';
  document.addEventListener('astro:page-load', bindEditor);
</script>
