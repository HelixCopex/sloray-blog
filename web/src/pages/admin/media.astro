---
import AdminLayout from '../../layouts/AdminLayout.astro';
import MediaPicker from '../../components/MediaPicker.astro';
import { serverGet, type Session } from '../../lib/api';
const cookie = Astro.request.headers.get('cookie') ?? '';
let admin = false;
try {
  const session = await serverGet<Session>('/auth/session', { headers: { cookie } });
  if (!session.user) return Astro.redirect('/login');
  admin = session.user.role === 'admin';
  if (!admin) Astro.response.status = 403;
} catch { Astro.response.status = 503; }
---
<AdminLayout title="媒体管理">
  <h1>媒体管理</h1>
  {admin ? <MediaPicker inline /> : <p role="alert">{Astro.response.status === 403 ? '只有管理员可以管理媒体。' : '媒体暂时不可用。'}</p>}
</AdminLayout>
