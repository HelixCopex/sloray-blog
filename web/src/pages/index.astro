---
import PostCard from '../components/PostCard.astro';
import PageDirectory from '../components/PageDirectory.astro';
import { defaultTheme } from '../lib/theme.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { serverGet, type PostPage } from '../lib/api';
const theme = Astro.locals.theme ?? defaultTheme;
const cursor = Astro.url.searchParams.get('cursor');
let page: PostPage = { items: [], next_cursor: null };
let unavailable = false;
try { page = await serverGet<PostPage>(`/posts?limit=20${cursor ? `&cursor=${encodeURIComponent(cursor)}` : ''}`); }
catch { unavailable = true; }
Astro.response.headers.set('Cache-Control', 'no-store');
---
<BaseLayout title="静线数据库">
  {theme.layout.home_blocks.map(block => block === 'hero' ? <section class="hero"><p class="eyebrow">静线数据库</p><h1>{theme.layout.hero_title || '文章'}</h1><p>{theme.layout.hero_description}</p></section> : block === 'pages' ? <PageDirectory server:defer><p slot="fallback" class="muted">正在读取页面…</p></PageDirectory> : <section aria-label="文章列表">
    {theme.layout.home_blocks.includes('hero') ? <h2>文章</h2> : <h1>文章</h1>}
    {unavailable ? <p role="status">文章服务暂时不可达，请稍后重试。</p> : page.items.length === 0 && <p>还没有已发布的文章。</p>}
    <ul class="post-list">{page.items.map(post => <li><PostCard post={post} /></li>)}</ul>
    {page.next_cursor && <a class="button-link tonal" href={`/?cursor=${encodeURIComponent(page.next_cursor)}`}>下一页</a>}
  </section>)}
</BaseLayout>
