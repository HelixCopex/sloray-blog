---
import BaseLayout from '../layouts/BaseLayout.astro';
import { serverGet, ApiRequestError, type Page } from '../lib/api';
import { renderMarkdown } from '../lib/render-markdown';
let page: Page | undefined;
let content = '';
try {
  page = await serverGet<Page>(`/pages/${encodeURIComponent(Astro.params.slug ?? '')}`);
  content = await renderMarkdown(page.body_md);
} catch (error) {
  page = undefined;
  Astro.response.status = error instanceof ApiRequestError && error.status === 404 ? 404 : 503;
}
---
<BaseLayout title={page?.title ?? '页面不可用'} description={page?.summary}>
  {page ? <article><h1>{page.title}</h1><div class="prose" set:html={content} /></article> : <><h1>{Astro.response.status === 404 ? '页面不存在' : '页面暂时不可用'}</h1><p><a href="/">返回首页</a></p></>}
</BaseLayout>
