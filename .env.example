# 可选：复制到仓库根目录 .env（已 gitignore，不会入库）。
# 根 CLI 自动读取当前目录或父目录的 .env；已有进程环境变量优先。
# 快速启动不需要此文件，见 docs/development.md。
#
# 这些变量通过 figment 的 `SLORAY_` 前缀映射到 Config 的字段：
#   SLORAY_BIND_ADDR  → config.bind_addr
#   ...
# 生产环境由 systemd 的 EnvironmentFile=/etc/sloray/api.env 提供。

# development | production
SLORAY_ENVIRONMENT=development

# pretty（本地可读）| json（生产：给 journald / Loki 采集）
SLORAY_LOG_FORMAT=pretty

# 只监听回环，公网流量经 Nginx 进入。
SLORAY_BIND_ADDR=127.0.0.1:8080

# 从仓库根运行时的本地私有配置目录；所有 CLI/worker 使用相同路径。
SLORAY_CONFIG_FILE=.dev-cache/runtime/config.json

# 可选覆盖。使用 ./scripts/dev-db.sh url 的输出，不要假设系统 5432 已有库。
# 留空注释即可通过 /setup 写入 config.json；环境变量会覆盖向导中的设置。
# SLORAY_DATABASE_URL=postgres://sloray:<实际密码>@127.0.0.1:55432/sloray

SLORAY_DATABASE_MAX_CONNECTIONS=10
SLORAY_DATABASE_ACQUIRE_TIMEOUT_SECS=5

# 收到 SIGTERM 后等待在途请求结束的秒数（systemd 的 TimeoutStopSec 要大于它）。
SLORAY_SHUTDOWN_TIMEOUT_SECS=10

# 可选媒体：私有原图与公开派生 bucket 必须不同。
# SLORAY_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# SLORAY_S3_REGION=auto
# SLORAY_S3_BUCKET=sloray-originals
# SLORAY_S3_ACCESS_KEY_ID=
# SLORAY_S3_SECRET_ACCESS_KEY=
# SLORAY_MEDIA_PUBLIC_BUCKET=sloray-public
# SLORAY_MEDIA_PUBLIC_BASE_URL=https://media.example.com
# SLORAY_CLOUDFLARE_ZONE_ID=
# SLORAY_CLOUDFLARE_API_TOKEN=
